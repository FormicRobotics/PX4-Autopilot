#!/bin/sh
#
# @name Gazebo x500 vision
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_vision}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Same camera-sync interface as the real vehicle: the camera_trigger driver
# plays the strobe at the camera's 30 Hz (mono_cam update_rate), MAVLink
# interface so no capture hardware is needed, and camera_timesync matches the
# sim companion's camera_frame_stamp against those edges (CAMTS_EN gates the
# module start in rcS; while locked the uXRCE-DDS client applies its offset).
param set-default TRIG_MODE 2
param set-default TRIG_INTERFACE 3
param set-default TRIG_INTERVAL 33.33
param set-default TRIG_ACT_TIME 10
param set-default CAMTS_EN 1
# No capture pins in simulation: the camera_trigger driver's edges are the strobe.
param set-default CAMTS_SRC 0

# Simulation only: the gz magnetometer is ideal, so there is nothing to learn. With the
# mag-bias estimator on, a flight with a bad yaw/disturbance left a wrong CAL_MAG0_*OFF in
# parameters.bson, the EKF then saw a 0.28 Gs / 42 deg field (reference 0.48 / 63) and refused
# yaw alignment and GNSS position, so the vehicle would not arm.
param set-default SENS_MAG_AUTOCAL 0
# And no GCS heartbeat needed to arm (4001 inherits NAV_DLL_ACT 2).
param set-default NAV_DLL_ACT 0
