#!/bin/sh
#
# aerium-radian-h7 board-sensors init  (PX4)
# --------------------------------------------------------------

board_adc start

# ───────────────────────────────────────────────────────────────
# IMU: ICM42688P (SPI2). It is vehicle_imu instance 0: EKF2, formic_vio_est, the rate controller and
# formic_imu_batch use it.
# The BMI270 on SPI1 is not used: its driver is not in the build (default.px4board), which frees its
# CPU time. Its chip select stays in src/spi.cpp so the chip is held deselected on the bus it shares
# with the DPS310. FORMIC_IMU_SEL has no effect on this board.
icm42688p -s start

# Magnetometers
# BMM150 (ArduPilot: I2C:0:0x10, ROTATION_YAW_180)
# PX4 enum: ROTATION_YAW_180 = 4
bmm150    -I -b 2 -R 4 start

# LIS3MDL (ArduPilot: I2C:0:0x1C, ROTATION_ROLL_180_YAW_90)
# PX4 enum: ROTATION_ROLL_180_YAW_270 = 14
lis3mdl   -I -a 30 -b 2 -R 14 start

# Barometers (ArduPilot lists DPS310 a.k.a. DPS368 and BMP388)
dps310    -s start
bmp388    -s start
